#!/usr/bin/env bash
# commit-msg — Plainframe protected-path gate (law 7), enforced at the git
# level so a raw `git commit` cannot bypass sync.sh's check (PF-003b).
#
# Blocks a commit that touches a protected path (see os/scripts/lib/guard.sh)
# unless the commit message has OWNER-CONFIRMED as its own line — trimmed of
# surrounding whitespace, it IS the whole line, nothing else. A mention, a
# prefix ("OWNER-CONFIRMED: ..."), or a negation ("this is NOT
# OWNER-CONFIRMED yet") never counts (PF-003a, hardened by adversarial
# review past an earlier word-boundary-substring rule that a negation could
# still slip through). Only the message itself counts: git hands this hook
# the raw file, so the diff `git commit -v` appends below its scissors line
# and the comment lines are cut first (PF-036). os/decisions.md is gated as
# os/guard.conf says: by default a pure append of new entries passes without
# the token (agents draft, the owner enacts — law 7); any edit to an existing
# line, or a new entry that already claims "**Status:** confirmed", needs the
# token (PF-005).
#
# An amend replaces HEAD, so it is judged against HEAD's parent, as pre-push
# will judge the stored commit: fixing your own unpushed draft is still a pure
# append, and an amend that drops an approval is caught here. git tells a hook
# nothing about --amend; the command line of the git that runs it does.
#
# What this hook cannot see — an approval line amended away later, or a
# commit made with --no-verify — the pre-push hook catches before it leaves
# the machine (PF-037).
#
# Wired by the same core.hooksPath as pre-commit: os/scripts/doctor.sh --setup
# Bypass once (owner's call): git commit --no-verify — break-glass only,
# never routine; pre-push still checks the stored message.

set -eu
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

MSG_FILE=${1:-}
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  echo "commit-msg: no commit message file given — refusing to guess (internal error)" >&2
  exit 2
fi

TMP=$(mktemp -d "${TMPDIR:-/tmp}/commit-msg.XXXXXX")
trap 'rm -rf "$TMP"' EXIT

# shellcheck source=../lib/guard.sh
. "$ROOT/os/scripts/lib/guard.sh"

MSG=$(clean_msg "$MSG_FILE")
if owner_confirmed "$MSG"; then
  exit 0
fi

BASE=HEAD
git rev-parse -q --verify HEAD >/dev/null || BASE=$EMPTY_TREE
case " $(ps -o args= -p "$PPID" 2>/dev/null || true) " in
  *" --amend "*|*" --amen "*|*" --ame "*|*" --am "*)
    if git rev-parse -q --verify 'HEAD^1' >/dev/null; then BASE='HEAD^1'; else BASE=$EMPTY_TREE; fi ;;
esac

: > "$TMP/prot"
# shellcheck disable=SC2086
git diff --cached --name-only --ignore-submodules=none "$BASE" -- $PROTECTED_PATHS >> "$TMP/prot" || true
if [ "$LEDGER_GATE" != off ] && [ -n "$(git diff --cached --name-only "$BASE" -- os/decisions.md)" ]; then
  OLD_LEDGER="$TMP/ledger-old"
  if git cat-file -e "$BASE:os/decisions.md" 2>/dev/null; then
    git show "$BASE:os/decisions.md" > "$OLD_LEDGER"
  else
    : > "$OLD_LEDGER"
  fi
  NEW_LEDGER="$TMP/ledger-new"
  if git cat-file -e :os/decisions.md 2>/dev/null; then
    git show :os/decisions.md > "$NEW_LEDGER"
  else
    : > "$NEW_LEDGER"
  fi
  if ledger_needs_token "$OLD_LEDGER" "$NEW_LEDGER"; then
    echo "os/decisions.md" >> "$TMP/prot"
  fi
fi

if [ -s "$TMP/prot" ]; then
  echo "BLOCKED: this commit touches protected path(s) (law 7 — agents draft, the owner enacts):" >&2
  sed 's/^/  /' "$TMP/prot" >&2
  echo "OWNER-CONFIRMED is an owner-only token — only the owner can approve this in-session." >&2
  cat >&2 <<'EOF'
With the owner's explicit in-session yes, make the token its own line in the
commit message (trimmed of surrounding whitespace) — a mention, prefix, or
negation elsewhere in the message never counts. Example:
  <commit message>
  <a line that is nothing but the token>
EOF
  exit 1
fi
exit 0
